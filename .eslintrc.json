{
  "env": { "browser": true, "es2021": true, "node": true },
  "parserOptions": { "ecmaVersion": 2021 },
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "warn",
    "no-redeclare": "error",
    "no-unreachable": "error",
    "eqeqeq": ["warn", "always"],
    "no-var": "warn",
    "prefer-const": "warn"
  }
}
